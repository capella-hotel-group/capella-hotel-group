          {
            "component": "text",
            "name": "tab-title",
            "label": "Tab Title",
            "valueType": "string",
            "required": true
          },
          {
            "component": "richtext",
            "name": "description",
            "label": "Description",
            "valueType": "string"
          },
          {
            "component": "reference",
            "name": "image",
            "label": "Tab Image",
            "valueType": "string",
            "alt": true
          }
        ]
      }
    ],
    "filters": [
        {
            "id": "promo-showcase",
